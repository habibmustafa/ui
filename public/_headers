# Cloudflare static assets: Vite emits content-hashed filenames under /assets, and the
# font files carry their version in the name, so both can be cached forever. Without
# this Cloudflare serves them with `max-age=0, must-revalidate`, i.e. a conditional
# request for every file on every visit. index.html stays revalidated so a deploy is
# picked up immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate
